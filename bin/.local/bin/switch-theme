#!/usr/bin/env bash
CHANGED=()

render() {
  local name="$1"
  local template="$2"
  local output="$3"
  local hook="$4"
  if [ -f "$template" ]; then
    echo "switching $name..."
    envsubst <"$template" >"$output"
    [ -n "$hook" ] && eval "$hook"
    CHANGED+=("$name")
  fi
}

if [ "$#" -eq 0 ]; then
  set -- --bemenu --foot --sway --swaylock --mako --x
  ARGS_GIVEN=false
else
  ARGS_GIVEN=true
fi

while [[ "$#" -gt 0 ]]; do
  case $1 in
    --bemenu)
      render bemenu ~/.config/bemenu/template.sh ~/.config/bemenu/args.sh
      shift
      ;;
    --foot)
      render foot ~/.config/foot/template.ini ~/.config/foot/foot.ini
      shift
      ;;
    --sway)
      render sway ~/.config/sway/template ~/.config/sway/config "command -v sway >/dev/null 2>&1 && sway & swaymsg exit"
      shift
      ;;
    --swaylock)
      render swaylock ~/.config/swaylock/template ~/.config/swaylock/config
      shift
      ;;
    --mako)
      render mako ~/.config/mako/template ~/.config/mako/config "command -v makoctl >/dev/null 2>&1 && makoctl reload"
      shift
      ;;
    --x)
      render xresources ~/.config/X11/template.Xresources ~/.config/X11/Xresources "xrdb merge ~/.config/X11/Xresources"
      shift
      ;;
  --zathura)
      render zathura ~/.config/zathura/template ~/.config/zathura/zathurarc
      shift
      ;;
    *)
      echo "Unknown parameter passed: $1"
      shift
      ;;
  esac
done

if [ "$ARGS_GIVEN" = true ]; then
  body="$THEME: $(IFS=,; echo "${CHANGED[*]}")"
else
  body="$THEME"
fi

if command -v notify-send >/dev/null 2>&1; then
  notify-send "Switched theme" "$body"
else
  echo "Switched theme: $body"
fi
