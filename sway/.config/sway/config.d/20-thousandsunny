# == services etc ========================================================
# this is only for alpine openrc

exec openrc -U gui

#exec_always dockerd-rootless
exec_always mpd-mpris
exec_always battery-alert
exec_always kdeconnectd

exec brightnessctl set 300

# == output ================================================================

font pango:Cozette 11
default_border pixel 2

# == swaybar =============================================================

bar {
	colors {
		background	$base
		statusline	$light
		separator		$overlay
#												border	  bg			  fg
		focused_workspace		$accent	  $accent	  $base
		active_workspace		$accent	  $accent	  $text
		inactive_workspace	$surface  $surface	$text
		urgent_workspace		$red	    $red	    $text
		binding_mode				$accent	  $accent	  $surface
	}
	font pango:Cozette 11
	position top
  status_command while ~/.config/sway/laptop.sh; do sleep 1; done
}


# == workspaces ==========================================================

workspace 1 output $builtin
workspace 2 output $builtin
workspace 3 output $builtin
workspace 5 output $tv

assign [app_id="Emacs"]                             $ws2

# -*- browsers -*-
assign [app_id="org.qutebrowser.qutebrowser"]				$ws3
assign [app_id="librewolf"]													$ws3

# -*- GUIs -*-
assign [app_id="org.pwmt.zathura"]									$ws4
assign [app_id="gimp"]															$ws4
assign [class="REAPER"]															$ws4
assign [app_id="org.kde.kdeconnect.app"]						$ws4

# -*- full-sreen -*-
assign [app_id="mpv"]																$ws5
assign [app_id='virt-manager']											$ws5

# -*- background -*-
assign [app_id="vesktop"]														$ws6
